{
  "name": "kitvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build UI prototypes from any design system, in any project, and check them in a local studio.",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  },
  "bin": {
    "kitvas": "bin/kitvas.ts"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=80 \"test/**/*.test.ts\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "types": "tsc --noEmit",
    "check": "npm run lint && npm run types && npm run test:coverage && npm audit --audit-level=high"
  },
  "dependencies": {
    "@types/react": "19.3.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass-embedded": "1.108.1",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/node": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5"
  }
}
