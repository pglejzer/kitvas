{
  "color": {
    "$type": "color",
    "bg": { "$value": { "colorSpace": "srgb", "components": [0.953, 0.957, 0.965] } },
    "surface": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1] } },
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.114, 0.125, 0.145] } },
    "inkMid": { "$value": { "colorSpace": "srgb", "components": [0.416, 0.439, 0.478] } },
    "inkSoft": { "$value": { "colorSpace": "srgb", "components": [0.643, 0.663, 0.698] } },
    "line": { "$value": { "colorSpace": "srgb", "components": [0.855, 0.867, 0.886] } },
    "lineStrong": { "$value": { "colorSpace": "srgb", "components": [0.525, 0.549, 0.588] } },
    "fix": { "$value": { "colorSpace": "srgb", "components": [0.702, 0.2, 0.122] } },
    "review": { "$value": { "colorSpace": "srgb", "components": [0.541, 0.353, 0] } },
    "good": { "$value": { "colorSpace": "srgb", "components": [0.122, 0.42, 0.227] } },
    "focus": { "$value": "{color.ink}" },
    "onInk": { "$value": "{color.surface}" },
    "veil": {
      "$value": { "colorSpace": "srgb", "components": [0.114, 0.125, 0.145], "alpha": 0.4 }
    }
  },
  "space": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } },
    "2xl": { "$value": { "value": 32, "unit": "px" } },
    "3xl": { "$value": { "value": 48, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 6, "unit": "px" } },
    "md": { "$value": { "value": 10, "unit": "px" } },
    "lg": { "$value": { "value": 14, "unit": "px" } },
    "full": { "$value": { "value": 999, "unit": "px" } }
  },
  "font": {
    "$type": "fontFamily",
    "body": { "$value": ["system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
    "mono": { "$value": ["ui-monospace", "Consolas", "monospace"] }
  },
  "fontSize": {
    "$type": "dimension",
    "sm": { "$value": { "value": 13, "unit": "px" } },
    "md": { "$value": { "value": 15, "unit": "px" } },
    "lg": { "$value": { "value": 18, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } },
    "2xl": { "$value": { "value": 32, "unit": "px" } },
    "3xl": { "$value": { "value": 46, "unit": "px" } }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "lineHeight": {
    "$type": "number",
    "tight": { "$value": 1.05 },
    "snug": { "$value": 1.25 },
    "normal": { "$value": 1.45 }
  },
  "motion": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "slow": { "$value": { "value": 240, "unit": "ms" } }
  },
  "size": {
    "$type": "dimension",
    "control": { "$value": { "value": 40, "unit": "px" } },
    "controlSm": { "$value": { "value": 32, "unit": "px" } },
    "icon": { "$value": { "value": 20, "unit": "px" } },
    "dialog": { "$value": { "value": 480, "unit": "px" } },
    "measure": {
      "$value": { "value": 640, "unit": "px" },
      "$description": "The widest a column of running text gets."
    },
    "page": {
      "$value": { "value": 1200, "unit": "px" },
      "$description": "The widest the page content gets."
    }
  }
}
