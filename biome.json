{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!docs",
      "!.superpowers",
      "!spikes",
      "!evals",
      "!reference/kit.schema.json",
      "!kits/kitvas-ui/json",
      "!kits/kitvas-ui/tsx/display/icon-paths.ts",
      "!kits/kitvas-ui/scss/core/_studio.scss",
      "!.playwright-mcp",
      "!.claude/settings.local.json",
      "!test/fixtures/projects/acme-templates/src",
      "!test/fixtures/projects/acme-sfc/src",
      "!test/fixtures/projects/acme-partials/src",
      "!test/fixtures/projects/acme-twcode/src",
      "!test/fixtures/projects/**/originals"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error",
        "noEvolvingTypes": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["test/fixtures/projects/acme-tailwind3/src/styles/globals.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": ["kits/kitvas-ui/scss/core/_base.scss"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["kits/kitvas-ui/tsx/display/Table.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveTabindex": "off"
          }
        }
      }
    },
    {
      "includes": ["kits/kitvas-ui/tsx/overlay/Tooltip.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off"
          }
        }
      }
    }
  ]
}
