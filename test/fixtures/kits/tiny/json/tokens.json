{
  "color": {
    "$type": "color",
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.114, 0.125, 0.145] } },
    "accent": { "$value": "{color.ink}" },
    "veil": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.5 } }
  },
  "space": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "none": { "$value": { "value": 0, "unit": "px" } }
  },
  "font": {
    "body": { "$type": "fontFamily", "$value": ["Inter", "Segoe UI", "sans-serif"] },
    "weightBold": { "$type": "fontWeight", "$value": 700 }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } }
  }
}
