{
  "color": {
    "$type": "color",
    "primary": {
      "$value": { "colorSpace": "srgb", "components": [0.1216, 0.3725, 0.8157], "hex": "#1f5fd0" }
    },
    "onPrimary": {
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
    },
    "surface": {
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
    },
    "ink": {
      "$value": { "colorSpace": "srgb", "components": [0.0588, 0.0902, 0.1647], "hex": "#0f172a" }
    },
    "line": {
      "$value": { "colorSpace": "srgb", "components": [0.7961, 0.8353, 0.8824], "hex": "#cbd5e1" }
    }
  },
  "space": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "md": { "$value": { "value": 6, "unit": "px" } }
  },
  "borderWidth": {
    "$type": "dimension",
    "thin": { "$value": { "value": 1, "unit": "px" } }
  },
  "fontSize": {
    "$type": "dimension",
    "sm": { "$value": { "value": 14, "unit": "px" } }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "medium": { "$value": 500 }
  },
  "lineHeight": {
    "$type": "dimension",
    "sm": { "$value": { "value": 20, "unit": "px" } }
  }
}
