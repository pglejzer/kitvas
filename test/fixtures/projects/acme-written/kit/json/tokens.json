{
  "color": {
    "$type": "color",
    "brand": {
      "$value": { "colorSpace": "srgb", "components": [0.0588, 0.4784, 0.3216], "hex": "#0f7a52" }
    },
    "ink": {
      "$value": { "colorSpace": "srgb", "components": [0.0431, 0.0471, 0.0471], "hex": "#0b0c0c" }
    },
    "line": {
      "$value": { "colorSpace": "srgb", "components": [0.8078, 0.8078, 0.8078], "hex": "#cecece" }
    },
    "soft": {
      "$value": { "colorSpace": "srgb", "components": [0.9529, 0.9529, 0.9529], "hex": "#f3f3f3" }
    },
    "white": {
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
    },
    "shadow": {
      "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.15, "hex": "#000000" }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 6, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } },
    "xxl": { "$value": { "value": 32, "unit": "px" } }
  },
  "font": {
    "$type": "fontFamily",
    "body": { "$value": ["system-ui", "sans-serif"] }
  }
}
