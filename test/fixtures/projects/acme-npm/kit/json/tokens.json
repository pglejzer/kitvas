{
  "color": {
    "$type": "color",
    "ink": {
      "$value": { "colorSpace": "srgb", "components": [0.102, 0.102, 0.102], "hex": "#1a1a1a" }
    },
    "accent": {
      "$value": { "colorSpace": "srgb", "components": [0, 0.3333, 1], "hex": "#0055ff" }
    }
  },
  "space": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } }
  }
}
