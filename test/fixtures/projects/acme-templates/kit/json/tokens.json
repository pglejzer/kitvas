{
  "color": {
    "$type": "color",
    "primary": {
      "$value": { "colorSpace": "srgb", "components": [0.1216, 0.3725, 0.8157], "hex": "#1f5fd0" }
    },
    "primaryHover": {
      "$value": { "colorSpace": "srgb", "components": [0.0941, 0.3098, 0.6824], "hex": "#184fae" }
    },
    "primaryActive": {
      "$value": { "colorSpace": "srgb", "components": [0.0706, 0.2392, 0.5333], "hex": "#123d88" }
    },
    "onPrimary": {
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
    },
    "ink": {
      "$value": { "colorSpace": "srgb", "components": [0.102, 0.1333, 0.2], "hex": "#1a2233" }
    },
    "muted": {
      "$value": { "colorSpace": "srgb", "components": [0.3569, 0.4, 0.4706], "hex": "#5b6678" }
    },
    "line": {
      "$value": { "colorSpace": "srgb", "components": [0.7647, 0.8039, 0.8784], "hex": "#c3cde0" }
    },
    "tint": {
      "$value": { "colorSpace": "srgb", "components": [0.9333, 0.9529, 0.9882], "hex": "#eef3fc" }
    },
    "tintActive": {
      "$value": { "colorSpace": "srgb", "components": [0.8667, 0.9059, 0.9765], "hex": "#dde7f9" }
    }
  },
  "space": {
    "$type": "dimension",
    "hair": { "$value": { "value": 2, "unit": "px" } },
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 6, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } }
  },
  "borderWidth": {
    "$type": "dimension",
    "thin": { "$value": { "value": 1, "unit": "px" } },
    "thick": { "$value": { "value": 2, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "input": { "$value": { "value": 240, "unit": "px" } },
    "card": { "$value": { "value": 320, "unit": "px" } }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "body": { "$value": ["Arial", "Helvetica", "sans-serif"] }
  },
  "fontSize": {
    "$type": "dimension",
    "sm": { "$value": { "value": 14, "unit": "px" } },
    "lg": { "$value": { "value": 18, "unit": "px" } }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "lineHeight": {
    "$type": "dimension",
    "sm": { "$value": { "value": 20, "unit": "px" } },
    "lg": { "$value": { "value": 24, "unit": "px" } }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.5 }
  }
}
