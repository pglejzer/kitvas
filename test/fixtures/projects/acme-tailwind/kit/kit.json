{
  "schemaVersion": 1,
  "id": "shad",
  "name": "Shad",
  "version": "0.0.0",
  "source": { "type": "repo", "path": "src/components/ui" },
  "framework": "react",
  "runtime": {
    "packages": [
      { "name": "react", "version": "19.3.1" },
      { "name": "react-dom", "version": "19.3.1" }
    ],
    "entry": "generated/kit.ts",
    "styles": {
      "files": [],
      "generated": "none",
      "imports": [],
      "tailwind": { "entry": "src/app/globals.css" }
    },
    "providers": []
  },
  "tokens": {
    "file": "json/tokens.json",
    "format": "dtcg-2025.10",
    "cssVars": { "prefix": "--", "map": "json/css-var-map.json" }
  },
  "components": [
    {
      "name": "Button",
      "category": "action",
      "description": "Starts an action or submits a form.",
      "import": { "from": "src/components/ui/button", "name": "Button" },
      "styling": ["className"],
      "props": [
        {
          "name": "variant",
          "type": "enum",
          "values": ["default", "outline"],
          "default": "default"
        },
        { "name": "size", "type": "enum", "values": ["default", "sm"], "default": "default" },
        { "name": "children", "type": "node", "required": true }
      ],
      "examples": [
        { "title": "Primary action", "code": "<Button>Save</Button>", "imports": ["Button"] },
        {
          "title": "Small outline",
          "code": "<Button variant=\"outline\" size=\"sm\">Cancel</Button>",
          "imports": ["Button"]
        }
      ],
      "a11y": ["A button that shows only an icon needs aria-label."]
    },
    {
      "name": "Card",
      "category": "layout",
      "description": "A bordered block that groups related content.",
      "import": { "from": "src/components/ui/card", "name": "Card" },
      "styling": ["className"],
      "props": [{ "name": "children", "type": "node", "required": true }],
      "examples": [
        {
          "title": "Plain card",
          "code": "<Card><p>Three tasks today.</p></Card>",
          "imports": ["Card"]
        }
      ]
    }
  ]
}
